import spidev
import time
from gpiozero import PWMLED

# MCP3008 Channel for LDR
LDR_CHANNEL = 1  

# Light intensity threshold
LIGHT_THRESHOLD = 800  # If LDR > 800, LED ON. If LDR < 800, LED OFF.

# Initialize PWM LED (GPIO 22)
led = PWMLED(22)

# Initialize SPI for MCP3008
spi = spidev.SpiDev()
spi.open(0, 0)  
spi.max_speed_hz = 1350000  

# Function to read from MCP3008
def read_adc(channel):
    if channel < 0 or channel > 7:
        return -1  
    adc = spi.xfer2([1, (8 + channel) << 4, 0])  
    data = ((adc[1] & 3) << 8) + adc[2]  
    return data

# Function to update LED based on LDR
def update_led_brightness():
    ldr_value = read_adc(LDR_CHANNEL)

    # Print LDR value for debugging
    print(f"LDR Value: {ldr_value}")

    # If LDR value is greater than 800 (low light), turn LED ON
    if ldr_value > LIGHT_THRESHOLD:
        led.value = 1.0  # Full brightness
        print("🔆 Low light detected! Turning LED ON.")
    
    # If LDR value is less than 800 (bright light), turn LED OFF
    else:
        led.value = 0  # LED OFF
        print("☀️ Bright light detected. Turning LED OFF.")

# Main loop
try:
    while True:
        update_led_brightness()
        time.sleep(2)  # Update every 2 seconds

except KeyboardInterrupt:
    print("Exiting program.")

finally:
    spi.close()
